<% name = @own.first.name %>
<% version = @own.first.version %>
<% content_for :title, "#{name} #{version} userland: every benchmark run | LinuxBenchHub" %>
<% content_for :description, "#{name} #{version} Phoronix Test Suite runs on x86_64 and arm64, lit in the comb beside Ubuntu, Fedora and Debian on the same kernels." %>

<div class="home">
  <div class="home-head">
    <h1 class="home-title lens-title" data-distro="<%= @distro %>"><span class="lit-name"><%= name %> <%= version %></span> userland.</h1>
    <p class="home-lede">Its column is lit. Same kernel, same machine as the others. <a href="/">Show every distro</a></p>
    <div class="machines">
      <% @own.each do |capture| %>
        <section class="machine" aria-labelledby="machine-<%= capture.arch %>">
          <h2 class="notes-title" id="machine-<%= capture.arch %>"><%= capture.arch %></h2>
          <% if capture.misfiled? %>
            <p class="warning">This capture reports a <%= capture.kernel %> kernel, which does not match its <%= capture.arch %> folder.</p>
          <% end %>
          <dl>
            <div><dt>System</dt><dd><%= capture.os %></dd></div>
            <div><dt>Compiler</dt><dd><%= capture.compiler %></dd></div>
            <div><dt>Kernel</dt><dd><%= capture.kernel %></dd></div>
            <div><dt>Capture</dt><dd><a class="utility" href="<%= capture.xml_url %>"><%= capture.title %></a></dd></div>
          </dl>
        </section>
      <% end %>
    </div>
  </div>
  <%= render "shared/comb", lit: @distro %>
</div>
