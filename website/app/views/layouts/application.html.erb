<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for(:title) || "LinuxBenchHub: every run of Ubuntu, Fedora and Debian on one rule" %></title>
    <% description = content_for(:description) || "Phoronix Test Suite runs for Ubuntu, Fedora and Debian on x86_64 and arm64, every run drawn as a tick on one rule per test." %>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="https://linuxbenchhub.vercel.app<%= request.path.chomp("/") %>/">
    <meta name="theme-color" content="#0a0507">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for(:title) || "LinuxBenchHub" %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="/social-card.png">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preload" href="/fonts/geist-100_900-normal.woff2" as="font" type="font/woff2" crossorigin>
    <script>
      (function () {
        var h = document.documentElement.classList;
        h.add("js");
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        h.add("motion", "intro");
        setTimeout(function () { h.remove("intro"); }, 2500);
      })();
    </script>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to the stack</a>
    <header class="corners">
      <a class="wordmark" href="/">LinuxBenchHub</a>
      <nav aria-label="Site">
        <a class="utility" href="/compare/">The ledger</a>
        <a class="utility" href="<%= Capture::REPO_URL %>">Source on GitHub</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <%= yield %>
    </main>
    <footer class="colophon">
      <% captures.group_by(&:arch).each do |arch, group| %>
        <p>
          <%= arch %> runs: <%= group.map(&:cpu).uniq.to_sentence %>
          (<%= group.map(&:threads).uniq.to_sentence %>) in <%= group.map(&:system_layer).uniq.to_sentence %>, captured
          <%= group.map { |c| c.date.iso8601 }.uniq.to_sentence %>.
        </p>
      <% end %>
      <p>
        Phoronix Test Suite <%= captures.map(&:pts_version).uniq.to_sentence %>.
        Code and data are MIT licensed. Type: Geist and Geist Mono.
      </p>
    </footer>
    <%= javascript_include_tag "gsap/gsap.min", "gsap/Flip.min", "site", defer: true %>
  </body>
</html>
