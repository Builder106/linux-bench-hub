<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0a0507">
    <meta name="color-scheme" content="light dark">
    <script>
      (function () {
        var scheme = document.querySelector('meta[name="color-scheme"]');
        try {
          var saved = localStorage.getItem("color-scheme");
          if (saved === "light" || saved === "dark") {
            localStorage.removeItem("theme");
          } else {
            saved = localStorage.getItem("theme");
            if (saved === "light" || saved === "dark") {
              localStorage.removeItem("theme");
              localStorage.setItem("color-scheme", saved);
            }
          }
          if (saved === "light" || saved === "dark") scheme.content = saved;
        } catch {}
        var light = scheme.content === "light" ||
          (scheme.content === "light dark" && matchMedia("(prefers-color-scheme: light)").matches);
        document.querySelector('meta[name="theme-color"]').content = light ? "#f4f6f8" : "#0a0507";
      })();
    </script>
    <title><%= content_for(:title) || "LinuxBenchHub: same kernel, three userlands" %></title>
    <% description = content_for(:description) || "Phoronix Test Suite runs for Ubuntu, Fedora and Debian in Docker on x86_64 and arm64, where all three share one kernel per machine and only userland differs." %>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="https://linuxbenchhub.vercel.app<%= request.path.chomp("/") %>/">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for(:title) || "LinuxBenchHub" %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="/social-card.png">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preload" href="/fonts/geist-100_900-normal.woff2" as="font" type="font/woff2" crossorigin>
    <script>
      (function () {
        var h = document.documentElement.classList;
        h.add("js");
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        h.add("motion", "intro");
        setTimeout(function () { h.remove("intro"); }, 2500);
      })();
    </script>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="corners">
      <a class="wordmark" href="/">LinuxBenchHub</a>
      <nav aria-label="Site">
        <a class="utility" href="/compare/">The ledger</a>
        <a class="utility" href="<%= Capture::REPO_URL %>">Source on GitHub</a>
        <button class="theme-toggle" type="button">
          <span class="theme-option theme-option-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="12" r="4" fill="currentColor"/>
              <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/>
                <line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/>
                <line x1="4.93" y1="4.93" x2="7.05" y2="7.05"/><line x1="16.95" y1="16.95" x2="19.07" y2="19.07"/>
                <line x1="4.93" y1="19.07" x2="7.05" y2="16.95"/><line x1="16.95" y1="7.05" x2="19.07" y2="4.93"/>
              </g>
            </svg>
            <span class="theme-label">Switch to light theme</span>
          </span>
          <span class="theme-option theme-option-dark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor"/>
            </svg>
            <span class="theme-label">Switch to dark theme</span>
          </span>
        </button>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <%= yield %>
    </main>
    <footer class="colophon">
      <% captures.group_by(&:arch).each do |arch, group| %>
        <p>
          <%= arch %> runs: <%= group.map(&:cpu).uniq.to_sentence %>
          (<%= group.map(&:threads).uniq.to_sentence %>) in <%= group.map(&:system_layer).uniq.to_sentence %>, captured
          <%= group.map { |c| c.date.iso8601 }.uniq.to_sentence %>.
        </p>
      <% end %>
      <p>
        Phoronix Test Suite <%= captures.map(&:pts_version).uniq.to_sentence %>.
        Code and data are MIT licensed. Type: Geist and Geist Mono.
      </p>
    </footer>
    <%= javascript_include_tag "gsap/gsap.min", "gsap/Flip.min", "site", "theme", defer: true %>
  </body>
</html>
